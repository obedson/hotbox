# Hotbox backend environment configuration.
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins. Leave empty to allow all
# (development only). Set this in production.
CORS_ORIGINS=

# Database (Supabase PostgreSQL connection string)
DATABASE_URL=
# Optional: path to a custom CA certificate for the database TLS connection.
# The Supabase root CA is bundled as backend/supabase-root-ca.pem.
DATABASE_CA_CERT=

# Authentication
# Generate a strong secret with: openssl rand -hex 48
JWT_SECRET=
# Public URL of the web app, used to build password-reset links.
APP_BASE_URL=http://localhost:3000
# Header-based identity is a development/demo convenience only.
# Never set this to "true" in production.
ALLOW_HEADER_AUTH=false

# Payment gateway (Paystack). Wallet top-ups are credited only after the
# gateway confirms the payment reference.
PAYSTACK_SECRET_KEY=

# NIPOST postcode API
POSTCODE_API_KEY=
NIPOST_API_KEY=

# Email delivery (pick one: SMTP/Gmail or Resend)
EMAIL_FROM=no-reply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
GMAIL_USER=
GMAIL_APP_PASS=
RESEND_API_KEY=

# SMS / WhatsApp delivery
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_DEVICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
